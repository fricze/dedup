{
  "name": "@yonki/dedup",
  "version": "0.1.1",
  "description": "Find duplicate/similar TypeScript type declarations across a codebase",
  "keywords": [
    "deduplication",
    "types",
    "typescript",
    "clean"
  ],
  "homepage": "https://github.com/fricze/dedup#readme",
  "bugs": {
    "url": "https://github.com/fricze/dedup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fricze/dedup.git"
  },
  "license": "MIT",
  "author": "Andrzej Fricze",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "dedup": "dist/cli.js",
    "dedup-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist"
  ],
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "mcp": "node dist/mcp-server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ts-morph": "^24.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
